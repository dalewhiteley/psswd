---
import Button from "./button.astro";
import Password from "./password.astro";
import TypewriterText from "./typewriter-text.astro";
---

<div>
    <TypewriterText text="Need a new password?" style="primary" />
    <h2>Generate a strong and memorable one.</h2>
    <Password />
    <Button type="primary" name="regeneratePassword">
        New password
        <i class="ph">arrows-clockwise</i>
        <script>
            import { generatePassword } from "../lib/password";
            import { $password } from "../lib/stores/password";

            document
                .querySelectorAll<HTMLButtonElement>(
                    'button[name="regeneratePassword"]',
                )
                .forEach((button) => {
                    button.addEventListener("click", (e) => {
                        $password.set(generatePassword());
                    });
                });
        </script>
        <style>
            :global(button):hover i {
                animation: spin 1.5s linear infinite 0.4s;
            }
            @keyframes spin {
                from {
                    transform: rotate(0deg);
                }
                to {
                    transform: rotate(360deg);
                }
            }
        </style>
    </Button>
</div>

<style>
    div {
        border-radius: 0.3em;
        display: flex;
        gap: 1em;
        flex-direction: column;
        align-items: flex-start;
        margin: auto 0;
        min-width: 0;
    }
    h1 {
        color: var(--color-primary);
        font-size: 3em;
        line-height: 1em;
        font-weight: 700;
    }
    h2 {
        color: var(--color-white);
        font-weight: 450;
    }

    @media screen and (max-width: 600px) {
        div {
            align-items: center;
            text-align: center;
        }
    }
</style>
