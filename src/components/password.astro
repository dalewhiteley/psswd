---
import IconButton from "./icon-button.astro";
---

<div>
    <span class="password">&nbsp;</span>
    <IconButton name="copy" icon="clipboard-text">
        <script>
            import { copyToClipboard, selectElement } from "../lib/browser";

            document
                .querySelectorAll<HTMLButtonElement>('button[name="copy"]')
                .forEach((button) => {
                    button.addEventListener("click", (e) => {
                        const target = e?.currentTarget as HTMLButtonElement;
                        if (!target) return;

                        const password =
                            target.parentNode?.querySelector(".password");

                        if (!password || !password?.textContent) return;

                        copyToClipboard(password.textContent);
                        selectElement(password as Node);
                    });
                });
        </script>
    </IconButton>
</div>
<script>
    import { $password } from "../lib/stores/password";

    const passwordElements =
        document.querySelectorAll<HTMLSpanElement>(".password");
    passwordElements.forEach((passwordElement) => {
        $password.subscribe((value) => {
            passwordElement.innerText = value;
        });
    });
</script>

<style>
    div {
        background-color: var(--color-white);
        color: var(--color-base);
        border-radius: 0.3em;
        width: 100%;
        min-width: 400px;
        display: flex;
    }
    span {
        padding: 0.2em 0.5em;
        text-align: center;
        font-size: 2em;
        font-weight: 600;
        flex: 1 1 100%;
        font-family: var(--mono-font-family);
        overflow-wrap: anywhere;
    }

    @media screen and (max-width: 600px) {
        div {
            min-width: 0;
        }
    }
</style>
