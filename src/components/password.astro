---
import IconButton from "./icon-button.astro";
---

<div>
    <span class="password">&nbsp;</span>
    <IconButton name="copy" icon="clipboard-text">
        <script>
            import { copyToClipboard, selectElement } from "../lib/browser";

            document
                .querySelectorAll<HTMLButtonElement>('button[name="copy"]')
                .forEach((button) => {
                    button.addEventListener("click", (e) => {
                        const target = e?.currentTarget as HTMLButtonElement;
                        if (!target) return;

                        const password =
                            target.parentNode?.querySelector(".password");

                        if (!password || !password?.textContent) return;

                        copyToClipboard(password.textContent);
                        selectElement(password as Node);
                    });
                });
        </script>
    </IconButton>
</div>
<script>
    import { $password } from "../lib/stores/password";

    const mobileMediaQuery = window.matchMedia("(max-width: 600px)");
    const passwordText =
        document.querySelectorAll<HTMLSpanElement>(".password");

    const mobileMediaQueryHandler = (
        e: MediaQueryList | MediaQueryListEvent,
    ) => {
        let searchValue: string | RegExp = "\n";
        let replaceValue = "";
        if (e.matches) {
            searchValue = /([A-Z])/g;
            replaceValue = "\n$1";
        }
        passwordText.forEach((password) => {
            console.log({ action: "ADD", text: password.innerHTML });
            password.innerText = password.innerText.replaceAll(
                searchValue,
                replaceValue,
            );
        });
    };

    const passwordElements =
        document.querySelectorAll<HTMLSpanElement>(".password");
    passwordElements.forEach((passwordElement) => {
        $password.subscribe((value) => {
            passwordElement.innerText = value;
            mobileMediaQueryHandler(mobileMediaQuery);
        });
    });

    mobileMediaQuery.addEventListener("change", mobileMediaQueryHandler);
</script>

<style>
    div {
        background-color: var(--color-white);
        color: var(--color-base);
        border-radius: 0.3em;
        width: 100%;
        min-width: 400px;
        display: flex;
    }
    span {
        padding: 0.2em 0.5em;
        text-align: center;
        font-size: 2em;
        font-weight: 600;
        flex: 1 1 100%;
        font-family: var(--mono-font-family);
        overflow-wrap: anywhere;
    }

    span::selection {
        background: rgba(var(--color-secondary-hex), 0.7);
    }

    @media screen and (max-width: 600px) {
        div {
            min-width: 0;
        }
    }
</style>
